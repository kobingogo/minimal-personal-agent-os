{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh/**",
        "~/.aws/**",
        "~/.config/gh/**",
        "~/.paos/config.json",
        "**/.env*"
      ],
      "denyWrite": [
        "~/.claude/**",
        "~/.codex/rules/**",
        "~/.paos/config.json",
        "~/.paos/cron_jobs.json",
        "~/.paos/logs/**",
        "~/.paos/store/**",
        "~/.paos/brain/CORE_RULES.md",
        "~/.ssh/**",
        "~/.aws/**",
        "~/.config/gh/**",
        "~/Library/LaunchAgents/**",
        "**/.claude/settings*.json",
        "**/.claude/hooks/**",
        "**/.git/hooks/**"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "api.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.paos/config.json)",
      "Edit(~/.claude/settings*.json)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.codex/rules/**)",
      "Edit(~/.paos/config.json)",
      "Edit(~/.paos/cron_jobs.json)",
      "Edit(~/.paos/logs/**)",
      "Edit(~/.paos/store/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(**/.claude/settings*.json)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.git/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre_tool_gate.py",
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/load_recent_memory.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
